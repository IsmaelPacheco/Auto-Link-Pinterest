/* =============================================================
   NEXUS PRO — Tema Escuro
   ============================================================= */
QMainWindow, QWidget { background-color: #090C13; color: #E7EAF3; font-family: 'Segoe UI', 'Inter', Arial, sans-serif; }
QToolTip { background-color: #161B29; color: #E7EAF3; border: 1px solid #262E43; padding: 6px 10px; border-radius: 6px; }

#sidebar { background-color: #0C0F18; border-right: 1px solid #1B2233; }
#logoBadge { background-color: #4F46E5; border-radius: 10px; }
#appTitle { color: #F5F6FA; font-size: 17px; font-weight: 800; letter-spacing: 0.3px; }
#appSubtitle { color: #545E78; font-size: 10px; font-weight: 600; letter-spacing: 1.5px; }

#navBtn { background-color: transparent; color: #7C879E; text-align: left; padding: 12px 18px; font-weight: 600; font-size: 13px; border-radius: 10px; margin: 0 12px; border: 1px solid transparent; }
#navBtn:hover { background-color: #141A28; color: #E7EAF3; }
#navBtnActive { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(99,102,241,0.22), stop:1 rgba(99,102,241,0.06));
                color: #A5B4FC; border: 1px solid rgba(99,102,241,0.35); text-align: left; padding: 12px 18px;
                font-weight: 700; font-size: 13px; border-radius: 10px; margin: 0 12px; }

#statusPill { background-color: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.3); border-radius: 12px; padding: 6px 14px; }
#statusText { color: #4ADE80; font-size: 11px; font-weight: 700; }

#cardPanel { background-color: #10141F; border: 1px solid #1C2333; border-radius: 14px; }
#headerTitle { color: #F5F6FA; font-size: 21px; font-weight: 800; letter-spacing: 0.2px; }
#headerSubtitle { color: #67718A; font-size: 12px; font-weight: 500; }
#sectionTitle { color: #818CF8; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.4px; }
#labelSmall { color: #67718A; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; }
#timerText { color: #34D399; font-size: 28px; font-weight: 800; font-family: 'Consolas', 'Courier New', monospace; }

QLineEdit, QComboBox, QDateTimeEdit { background-color: #090C13; color: #E7EAF3; border: 1px solid #232B3F; border-radius: 8px; padding: 11px 12px; font-size: 13px; selection-background-color: #4F46E5; }
QLineEdit:hover, QComboBox:hover { border: 1px solid #313B54; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #6366F1; background-color: #0D111C; }
QComboBox::drop-down { border: none; width: 32px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #7C879E; margin-right: 12px; }
QComboBox QAbstractItemView { background-color: #131826; color: #E7EAF3; border: 1px solid #232B3F; selection-background-color: #4F46E5; selection-color: #ffffff; border-radius: 8px; outline: none; padding: 4px; }

QTextEdit { background-color: #080A10; color: #5EEAD4; border: 1px solid #1C2333; border-radius: 12px; font-family: 'Cascadia Code', Consolas, monospace; font-size: 12px; padding: 14px; selection-background-color: #4F46E5; }

QPushButton { font-weight: 700; font-size: 13px; border-radius: 9px; padding: 11px; border: none; }
#btnPrimary { background-color: #4F46E5; color: #FFFFFF; }
#btnPrimary:hover { background-color: #4338CA; }
#btnPrimary:pressed { background-color: #3730A3; }
#btnSecondary { background-color: #161B29; color: #C7CEDD; border: 1px solid #262E43; }
#btnSecondary:hover { background-color: #1D2434; border: 1px solid #313B54; }
#btnSuccess { background-color: #16A34A; color: #FFFFFF; }
#btnSuccess:hover { background-color: #15803D; }
#btnDanger { background-color: #E11D48; color: #FFFFFF; }
#btnDanger:hover { background-color: #BE123C; }
#btnTheme { background-color: #161B29; color: #FBBF24; border: 1px solid #262E43; border-radius: 18px; padding: 8px 16px; }
#btnTheme:hover { background-color: #1D2434; }