/* =============================================================
   NEXUS PRO — Tema Claro
   ============================================================= */
QMainWindow, QWidget { background-color: #F5F6FB; color: #12172B; font-family: 'Segoe UI', 'Inter', Arial, sans-serif; }
QToolTip { background-color: #FFFFFF; color: #12172B; border: 1px solid #E1E4EE; padding: 6px 10px; border-radius: 6px; }

#sidebar { background-color: #FFFFFF; border-right: 1px solid #ECEEF6; }
#logoBadge { background-color: #4F46E5; border-radius: 10px; }
#appTitle { color: #12172B; font-size: 17px; font-weight: 800; letter-spacing: 0.3px; }
#appSubtitle { color: #9AA1B7; font-size: 10px; font-weight: 600; letter-spacing: 1.5px; }

#navBtn { background-color: transparent; color: #6B7290; text-align: left; padding: 12px 18px; font-weight: 600; font-size: 13px; border-radius: 10px; margin: 0 12px; border: 1px solid transparent; }
#navBtn:hover { background-color: #F1F2FA; color: #12172B; }
#navBtnActive { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(79,70,229,0.14), stop:1 rgba(79,70,229,0.04));
                color: #4F46E5; border: 1px solid rgba(79,70,229,0.25); text-align: left; padding: 12px 18px;
                font-weight: 700; font-size: 13px; border-radius: 10px; margin: 0 12px; }

#statusPill { background-color: rgba(22,163,74,0.10); border: 1px solid rgba(22,163,74,0.28); border-radius: 12px; padding: 6px 14px; }
#statusText { color: #16A34A; font-size: 11px; font-weight: 700; }

#cardPanel { background-color: #FFFFFF; border: 1px solid #ECEEF6; border-radius: 14px; }
#headerTitle { color: #12172B; font-size: 21px; font-weight: 800; letter-spacing: 0.2px; }
#headerSubtitle { color: #8A90A8; font-size: 12px; font-weight: 500; }
#sectionTitle { color: #4F46E5; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.4px; }
#labelSmall { color: #8A90A8; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; }
#timerText { color: #059669; font-size: 28px; font-weight: 800; font-family: 'Consolas', 'Courier New', monospace; }

QLineEdit, QComboBox, QDateTimeEdit { background-color: #F5F6FB; color: #12172B; border: 1px solid #E1E4EE; border-radius: 8px; padding: 11px 12px; font-size: 13px; selection-background-color: #4F46E5; selection-color: #ffffff; }
QLineEdit:hover, QComboBox:hover { border: 1px solid #C7CCE2; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #4F46E5; background-color: #FFFFFF; }
QComboBox::drop-down { border: none; width: 32px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #8A90A8; margin-right: 12px; }
QComboBox QAbstractItemView { background-color: #FFFFFF; color: #12172B; selection-background-color: #4F46E5; selection-color: #ffffff; border: 1px solid #E1E4EE; border-radius: 8px; outline: none; padding: 4px; }

QTextEdit { background-color: #FAFBFE; color: #12172B; border: 1px solid #ECEEF6; border-radius: 12px; font-family: 'Cascadia Code', Consolas, monospace; font-size: 12px; padding: 14px; selection-background-color: #4F46E5; selection-color: #ffffff; }

QPushButton { font-weight: 700; font-size: 13px; border-radius: 9px; padding: 11px; border: none; }
#btnPrimary { background-color: #4F46E5; color: #FFFFFF; }
#btnPrimary:hover { background-color: #4338CA; }
#btnPrimary:pressed { background-color: #3730A3; }
#btnSecondary { background-color: #F5F6FB; color: #12172B; border: 1px solid #E1E4EE; }
#btnSecondary:hover { background-color: #ECEEF6; border: 1px solid #C7CCE2; }
#btnSuccess { background-color: #16A34A; color: #FFFFFF; }
#btnSuccess:hover { background-color: #15803D; }
#btnDanger { background-color: #E11D48; color: #FFFFFF; }
#btnDanger:hover { background-color: #BE123C; }
#btnTheme { background-color: #FFFFFF; color: #B45309; border: 1px solid #E1E4EE; border-radius: 18px; padding: 8px 16px; }
#btnTheme:hover { background-color: #F5F6FB; }